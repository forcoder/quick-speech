<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D4D6D8">

    <!-- 候选栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="#E4E6E8">

        <TextView
            android:id="@+id/input_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingEnd="4dp"
            android:minWidth="28dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidates_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- AI 建议回复区域（可折叠） -->
    <LinearLayout
        android:id="@+id/ai_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0F2F4"
        android:visibility="gone">

        <!-- AI 面板标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="#E8EAEC">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 AI 建议"
                android:textSize="11sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 知识库搜索入口 -->
            <TextView
                android:id="@+id/btn_knowledge_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 知识库"
                android:textSize="10sp"
                android:textColor="#1565C0"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 模式切换 -->
            <TextView
                android:id="@+id/btn_ai_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔀"
                android:textSize="10sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 收起按钮 -->
            <TextView
                android:id="@+id/btn_ai_collapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="10sp"
                android:textColor="#999999"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- AI 回复列表 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/ai_replies_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- 知识库搜索结果区域 -->
        <LinearLayout
            android:id="@+id/knowledge_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 知识库搜索结果"
                android:textSize="11sp"
                android:textColor="#555555"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/knowledge_results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

    <!-- 键盘区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- 数字行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/key_1" style="@style/WubiKey.Num" android:text="1" />
            <TextView android:id="@+id/key_2" style="@style/WubiKey.Num" android:text="2" />
            <TextView android:id="@+id/key_3" style="@style/WubiKey.Num" android:text="3" />
            <TextView android:id="@+id/key_4" style="@style/WubiKey.Num" android:text="4" />
            <TextView android:id="@+id/key_5" style="@style/WubiKey.Num" android:text="5" />
            <TextView android:id="@+id/key_6" style="@style/WubiKey.Num" android:text="6" />
            <TextView android:id="@+id/key_7" style="@style/WubiKey.Num" android:text="7" />
            <TextView android:id="@+id/key_8" style="@style/WubiKey.Num" android:text="8" />
            <TextView android:id="@+id/key_9" style="@style/WubiKey.Num" android:text="9" />
            <TextView android:id="@+id/key_0" style="@style/WubiKey.Num" android:text="0" />

        </LinearLayout>

        <!-- QWERTYUIOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/key_q" style="@style/WubiKey" android:text="Q" />
            <TextView android:id="@+id/key_w" style="@style/WubiKey" android:text="W" />
            <TextView android:id="@+id/key_e" style="@style/WubiKey" android:text="E" />
            <TextView android:id="@+id/key_r" style="@style/WubiKey" android:text="R" />
            <TextView android:id="@+id/key_t" style="@style/WubiKey" android:text="T" />
            <TextView android:id="@+id/key_y" style="@style/WubiKey" android:text="Y" />
            <TextView android:id="@+id/key_u" style="@style/WubiKey" android:text="U" />
            <TextView android:id="@+id/key_i" style="@style/WubiKey" android:text="I" />
            <TextView android:id="@+id/key_o" style="@style/WubiKey" android:text="O" />
            <TextView android:id="@+id/key_p" style="@style/WubiKey" android:text="P" />

        </LinearLayout>

        <!-- ASDFGHJKL 缩进 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView android:id="@+id/key_a" style="@style/WubiKey" android:text="A" />
            <TextView android:id="@+id/key_s" style="@style/WubiKey" android:text="S" />
            <TextView android:id="@+id/key_d" style="@style/WubiKey" android:text="D" />
            <TextView android:id="@+id/key_f" style="@style/WubiKey" android:text="F" />
            <TextView android:id="@+id/key_g" style="@style/WubiKey" android:text="G" />
            <TextView android:id="@+id/key_h" style="@style/WubiKey" android:text="H" />
            <TextView android:id="@+id/key_j" style="@style/WubiKey" android:text="J" />
            <TextView android:id="@+id/key_k" style="@style/WubiKey" android:text="K" />
            <TextView android:id="@+id/key_l" style="@style/WubiKey" android:text="L" />

        </LinearLayout>

        <!-- Z~M 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/key_z" style="@style/WubiKey" android:text="Z" />
            <TextView android:id="@+id/key_x" style="@style/WubiKey" android:text="X" />
            <TextView android:id="@+id/key_c" style="@style/WubiKey" android:text="C" />
            <TextView android:id="@+id/key_v" style="@style/WubiKey" android:text="V" />
            <TextView android:id="@+id/key_b" style="@style/WubiKey" android:text="B" />
            <TextView android:id="@+id/key_n" style="@style/WubiKey" android:text="N" />
            <TextView android:id="@+id/key_m" style="@style/WubiKey" android:text="M" />

        </LinearLayout>

        <!-- 功能切换行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <!-- 符号切换 -->
            <TextView
                android:id="@+id/key_symbol"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="符" />

            <!-- AI 面板展开 -->
            <TextView
                android:id="@+id/key_ai_toggle"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="💡" />

            <!-- 中英文切换 -->
            <TextView
                android:id="@+id/key_toggle_lang"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="中/英" />

            <!-- 语音输入 -->
            <TextView
                android:id="@+id/key_voice"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="🎤" />

            <!-- 删除 -->
            <TextView
                android:id="@+id/key_backspace"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="⌫" />

            <!-- 回车 -->
            <TextView
                android:id="@+id/key_enter"
                style="@style/WubiKey.Func"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_enter_key_bg"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="Enter" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
